{
  "name": "Ribbonmere",
  "short_name": "Ribbonmere",
  "description": "A little village at the quiet end of the internet.",
  "start_url": "/dollhouse",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f6e9e4",
  "theme_color": "#f4c6d0",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "Letterbox", "url": "/dollhouse/inbox" },
    { "name": "Reading Room", "url": "/dollhouse/reading" }
  ]
}
