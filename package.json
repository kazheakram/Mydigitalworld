{
  "name": "ribbonmere",
  "version": "0.1.0",
  "private": true,
  "description": "Ribbonmere — a coquette storybook village, personal website and private internet headquarters.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "tsx --test server/tests/*.test.ts",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.1.0",
    "@fontsource/homemade-apple": "5.1.0",
    "@fontsource/pinyon-script": "5.1.0",
    "@fontsource/pixelify-sans": "5.1.0",
    "express": "4.21.2",
    "fast-xml-parser": "4.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "tsx": "4.19.2"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "playwright": "1.49.0",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
